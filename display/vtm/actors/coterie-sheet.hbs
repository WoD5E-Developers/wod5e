<div class='flexrow coterie-features grid-2col'>
  <div class='chasse'>
    <div class='flexrow field-header'>
      <label class='resource-label' for='system.chasse.value'>
        {{#if groupSheetHeaders.chasse}}
          {{ groupSheetHeaders.chasse }}
        {{else}}
          {{localize "WOD5E.VTM.Chasse"}}
        {{/if}}
      </label>
    </div>
    <div class='resource resource-content'>
      <div class='resource-value' data-value='{{ chasse.value }}' data-name='system.chasse.value'>
        <span class='resource-value-empty' data-action='dotCounterEmpty'></span>
        {{#numLoop 5}}
          <span class='resource-value-step' data-action='dotCounterChange' data-index='{{ this }}'
          ></span>
        {{/numLoop}}
      </div>
    </div>
  </div>
  <div class='lien'>
    <div class='flexrow field-header'>
      <label class='resource-label' for='system.lien.value'>
        {{#if groupSheetHeaders.lien}}
          {{ groupSheetHeaders.lien }}
        {{else}}
          {{localize "WOD5E.VTM.Lien"}}
        {{/if}}
      </label>
    </div>
    <div class='resource resource-content'>
      <div class='resource-value' data-value='{{ lien.value }}' data-name='system.lien.value'>
        <span class='resource-value-empty' data-action='dotCounterEmpty'></span>
        {{#numLoop 5}}
          <span class='resource-value-step' data-action='dotCounterChange' data-index='{{ this }}'
          ></span>
        {{/numLoop}}
      </div>
    </div>
  </div>
  {{#ifgr chasse.value 0}}
    <div class='hunting-difficulty'>
      <div class='flexrow field-header'>
        <label class='resource-label'>
          {{#if groupSheetHeaders.huntingDifficulty}}
            {{ groupSheetHeaders.huntingDifficulty }}
          {{else}}
            {{localize "WOD5E.VTM.HuntingDifficulty"}}
          {{/if}}
        </label>
      </div>
      <div class='resource resource-content'>
        <div class='resource-value'>{{ huntingDifficulty }}</div>
      </div>
    </div>
  {{/ifgr}}
  <div class='portillon'>
    <div class='flexrow field-header'>
      <label class='resource-label' for='system.portillon.value'>
        {{#if groupSheetHeaders.portillon}}
          {{ groupSheetHeaders.portillon }}
        {{else}}
          {{localize "WOD5E.VTM.Portillon"}}
        {{/if}}
      </label>
    </div>
    <div class='resource resource-content'>
      <div
        class='resource-value'
        data-value='{{ portillon.value }}'
        data-name='system.portillon.value'
      >
        <span class='resource-value-empty' data-action='dotCounterEmpty'></span>
        {{#numLoop 5}}
          <span class='resource-value-step' data-action='dotCounterChange' data-index='{{ this }}'
          ></span>
        {{/numLoop}}
      </div>
    </div>
  </div>
</div>
