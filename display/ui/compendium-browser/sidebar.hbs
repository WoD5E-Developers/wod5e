<div class='compendium-browser-sidebar flexcol'>
  <div class='search-section'>
    <input
      class='search-input'
      type='text'
      name='search'
      placeholder='Search...'
      data-action='search'
      value='{{ textFilter }}'
    />
  </div>
  <div class='results-sort'>
    {{localize 'WOD5E.CompendiumBrowser.Sort'}}
    <select name='sort'>
      {{selectOptions
        sortOptions
        selected=sort
        localize=true
      }}
    </select>
  </div>
  <div class='search-filters'>
    {{> "systems/wod5e/display/ui/compendium-browser/parts/filter-dots.hbs"}}
    {{> "systems/wod5e/display/ui/compendium-browser/parts/filter-splats.hbs"}}
    {{> "systems/wod5e/display/ui/compendium-browser/parts/filter-types.hbs"}}
  </div>
</div>
