<div class='rating-filter flexcol'>
  <span>{{localize 'WOD5E.CompendiumBrowser.Rating'}}</span>
  <div class='flexrow'>
    <label>
      {{localize 'WOD5E.CompendiumBrowser.Minimum'}}
      <input
        type='number'
        name='ratingMin'
        min='0'
        step='1'
        value='{{ ratingMin }}'
        placeholder='{{localize "WOD5E.CompendiumBrowser.AllRatings"}}'
      />
    </label>
    <label>
      {{localize 'WOD5E.CompendiumBrowser.Maximum'}}
      <input
        type='number'
        name='ratingMax'
        min='0'
        step='1'
        value='{{ ratingMax }}'
        placeholder='{{localize "WOD5E.CompendiumBrowser.AllRatings"}}'
      />
    </label>
  </div>
</div>
